{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trip-cut EDL",
  "type": "object",
  "required": ["project", "output", "clips"],
  "properties": {
    "project": {"type": "string"},
    "output": {
      "type": "object",
      "required": ["aspect", "fps", "target_duration"],
      "properties": {
        "aspect": {"enum": ["9:16", "16:9", "1:1"]},
        "fps": {"type": "integer", "default": 30},
        "target_duration": {"type": "number"}
      }
    },
    "bgm": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "volume": {"type": "number", "minimum": 0, "maximum": 1},
        "duck_under_speech": {"type": "boolean"}
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "source"],
        "properties": {
          "seq": {"type": "integer"},
          "source": {"type": "string"},
          "start": {"type": "number", "description": "photo：在時間軸上的相對用途，通常 0"},
          "duration": {"type": "number", "description": "photo 停留秒數"},
          "in": {"type": "number", "description": "video 取用起點（秒）"},
          "out": {"type": "number", "description": "video 取用終點（秒）"},
          "keep_audio": {"type": "boolean"},
          "audio_override": {
            "type": "object",
            "description": "用另一支影片的聲音蓋在這段畫面上（例如小孩視角：畫面用 330s、聲音用 150s 的對話）",
            "required": ["source", "in"],
            "properties": {
              "source": {"type": "string"},
              "in": {"type": "number", "description": "聲音來源的起點（秒），長度跟畫面一樣"}
            }
          },
          "crop": {"description": "center|left|right 或 0..1 的 x 焦點", "anyOf": [{"enum": ["center", "left", "right"]}, {"type": "number", "minimum": 0, "maximum": 1}]},
          "effect": {"enum": ["none", "kenburns"]},
          "kenburns": {
            "type": "object",
            "properties": {
              "from": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "[cx, cy, scale]"},
              "to": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
            }
          },
          "title": {
            "type": "object",
            "properties": {
              "text": {"type": "string"},
              "style": {"enum": ["lower-third", "center", "chapter"]}
            }
          },
          "transition_out": {"enum": ["cut", "crossfade", "fade-black", "slide"]}
        }
      }
    }
  }
}
