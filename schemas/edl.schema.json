{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trip-cut EDL",
  "type": "object",
  "required": [
    "project",
    "output",
    "clips"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "required": [
        "aspect",
        "fps",
        "target_duration"
      ],
      "properties": {
        "aspect": {
          "enum": [
            "9:16",
            "16:9",
            "1:1"
          ]
        },
        "fps": {
          "type": "integer",
          "default": 30
        },
        "target_duration": {
          "type": "number"
        },
        "preset": {
          "enum": [
            "family",
            "guide"
          ],
          "description": "風格模板，見 docs/STYLE-TEMPLATE.md §6"
        },
        "grade": {
          "enum": [
            "warm",
            "cool",
            "fresh",
            "none"
          ],
          "description": "全片調色，可被 clip.grade 覆寫"
        }
      }
    },
    "bgm": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duck_under_speech": {
          "type": "boolean"
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "seq",
          "source"
        ],
        "properties": {
          "seq": {
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "description": "photo：在時間軸上的相對用途，通常 0"
          },
          "duration": {
            "type": "number",
            "description": "photo 停留秒數"
          },
          "in": {
            "type": "number",
            "description": "video 取用起點（秒）"
          },
          "out": {
            "type": "number",
            "description": "video 取用終點（秒）"
          },
          "keep_audio": {
            "type": "boolean"
          },
          "audio_override": {
            "type": "object",
            "description": "用另一支影片的聲音蓋在這段畫面上（例如小孩視角：畫面用 330s、聲音用 150s 的對話）",
            "required": [
              "source",
              "in"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "in": {
                "type": "number",
                "description": "聲音來源的起點（秒），長度跟畫面一樣"
              }
            }
          },
          "crop": {
            "description": "center|left|right 或 0..1 的 x 焦點",
            "anyOf": [
              {
                "enum": [
                  "center",
                  "left",
                  "right"
                ]
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ]
          },
          "effect": {
            "enum": [
              "none",
              "kenburns"
            ]
          },
          "kenburns": {
            "type": "object",
            "properties": {
              "from": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "[cx, cy, scale]"
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "title": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "style": {
                "enum": [
                  "lower-third",
                  "center",
                  "chapter"
                ]
              }
            }
          },
          "transition_out": {
            "enum": [
              "cut",
              "crossfade",
              "fade-black",
              "slide"
            ]
          },
          "grade": {
            "enum": [
              "warm",
              "cool",
              "fresh",
              "none"
            ],
            "description": "這一段的調色，覆寫 output.grade"
          },
          "captions": {
            "type": "array",
            "description": "四層字幕，見 docs/STYLE-TEMPLATE.md §3",
            "items": {
              "type": "object",
              "required": [
                "layer",
                "text"
              ],
              "properties": {
                "layer": {
                  "enum": [
                    "chapter",
                    "main",
                    "translit",
                    "emphasis"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "in": {
                  "type": "number",
                  "description": "相對本 clip 的秒數，預設 0"
                },
                "out": {
                  "type": "number",
                  "description": "相對本 clip 的秒數，預設到段落結束"
                },
                "pos": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x,y] 畫面比例；省略用該層預設位置"
                },
                "tone": {
                  "enum": [
                    "neutral",
                    "author"
                  ],
                  "description": "main 層：neutral=黑描邊 / author=粉紅描邊"
                },
                "anim": {
                  "enum": [
                    "none",
                    "pulse",
                    "pop"
                  ],
                  "description": "emphasis 建議 pulse"
                },
                "size": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 0.3,
                  "description": "字級佔畫面寬的比例，覆寫該層預設（chapter/main 0.055-0.058、emphasis 0.115）"
                }
              }
            }
          },
          "badge": {
            "type": "object",
            "required": [
              "primary"
            ],
            "description": "位置膠囊",
            "properties": {
              "icon": {
                "type": "string"
              },
              "primary": {
                "type": "string",
                "description": "類別，橘褐色"
              },
              "secondary": {
                "type": "string",
                "description": "專名，深褐色"
              },
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "photo_frame": {
            "enum": [
              "none",
              "polaroid"
            ],
            "description": "照片外框；polaroid = 米白紙 + 旋轉 + 投影"
          },
          "rotate": {
            "type": "number",
            "description": "polaroid 的旋轉角度，預設 -4"
          },
          "silence": {
            "type": "object",
            "required": [
              "in",
              "out"
            ],
            "description": "相對本 clip 的絕對靜音區間（開場懸念用）",
            "properties": {
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}